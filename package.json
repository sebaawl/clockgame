  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0"
  }
}
